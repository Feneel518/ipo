# Copy to .env for local development. Never commit the copied file.
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Use the pooled Postgres URL provided by Neon or Supabase.
# Keep sslmode=require for hosted databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# The in-process scheduler starts with the API process when a database is configured.
SCHEDULER_ENABLED=true

# Personal Telegram bot token and your own numeric chat ID. Keep both secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Asia/Kolkata hour (0-23) for the once-daily watchdog heartbeat.
WATCHDOG_DIGEST_HOUR=9
