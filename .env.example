# Copy to .env for local development. Never commit the copied file.
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Use the pooled Postgres URL provided by Neon or Supabase.
# Keep sslmode=require for hosted databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
