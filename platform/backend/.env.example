DATABASE_URL=postgresql+psycopg://ipodekho:ipodekho@localhost:5432/ipodekho
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_TOKEN=replace-with-a-long-random-value
RAW_SNAPSHOT_BUCKET=
# Cloudflare R2 (leave all four blank to disable RHP archiving locally)
R2_BUCKET=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Comma-separated source hosts; subdomains are accepted.
RHP_ALLOWED_HOSTS=nseindia.com,bseindia.com
RHP_DOWNLOAD_MAX_BYTES=209715200
# Direct Gemini processing limits; larger PDFs are retained and flagged for optimization/splitting.
GEMINI_SAFE_PDF_BYTES=47185920
GEMINI_MAX_PDF_PAGES=1000
RHP_CHUNK_MAX_BYTES=41943040
RHP_CHUNK_MAX_PAGES=300
# Gemini credentials are backend-only. Never expose this variable to the frontend.
GEMINI_API_KEY=
RHP_PRIMARY_MODEL=gemini-3.5-flash-lite
RHP_PROMPT_VERSION=rhp-v1.7
RHP_SCHEMA_VERSION=rhp-v1.1
RHP_EXTRACTION_BATCH_SIZE=5
RHP_EXTRACTION_MAX_ATTEMPTS=3
GEMINI_FILE_TIMEOUT_SECONDS=300
GEMINI_FILE_POLL_SECONDS=2
GEMINI_REQUEST_TIMEOUT_SECONDS=180
REVALIDATION_URL=http://localhost:3000/api/revalidate
REVALIDATION_SECRET=replace-with-a-long-random-value
