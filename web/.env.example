# Copy to .env for local development. Never commit the copied file.

# Connection string for the `web_readonly` Postgres role (see
# ../database/migrations/0005_web_readonly_role.sql), NOT the worker's
# read-write role. SELECT-only on ipos, subscription_snapshots, and
# listing_performance; every other table will reject this role.
# Use the pooled Postgres URL provided by Neon or Supabase and keep
# sslmode=require for hosted databases.
DATABASE_URL=postgresql://web_readonly:PASSWORD@HOST:5432/DATABASE?sslmode=require
